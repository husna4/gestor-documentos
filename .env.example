# Archivo OPCIONAL: copia a .env solo si quieres cambiar estos valores.
# docker compose up --build -d --wait funciona sin .env en Windows y Linux.
# Las contraseñas y la clave de sesión se generan en volúmenes persistentes.
# No se leen POSTGRES_PASSWORD, DB_PASSWORD, ADMIN_PASSWORD ni REMEMBER_ME_KEY de .env.

# Solo se aplica al crear los secretos por primera vez; después se conserva el usuario.
ADMIN_USERNAME=admin

# Puerto publicado en el equipo anfitrión. El contenedor siempre escucha en 8090.
APP_PORT=8090

# Opciones del gestor (los valores aquí son los predeterminados).
APP_MAX_FILE_SIZE=20MB
APP_MAX_REQUEST_SIZE=200MB
DOCSCANNER_CONNECT_TIMEOUT=3s
DOCSCANNER_REQUEST_TIMEOUT=30s
DOCSCANNER_MAX_RESPONSE_SIZE=20MB
APP_SCAN_TEMP_TTL=30m
APP_SCAN_TEMP_MAX_SIZE=500MB
APP_SCAN_TEMP_MAX_PER_USER=20
APP_SCAN_TEMP_MAX_TOTAL=100
# DocScanner usa sus límites propios (20 MiB por archivo por defecto).
# Si aumentas los del gestor, ajusta también SCANNER_* en compose.yaml.
